{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "./init.sh": "allow",
      "npm test*": "allow",
      "npx tsx src/cli.ts*": "allow",
    },
  },
  "instructions": [
    "After editing or writing files, run npm test -- --reporter=dot 2>&1 | tail -5",
  ],
  "mcp": {
    "context-mode": {
      "type": "local",
      "command": ["context-mode"],
    },
  },
  "plugin": ["context-mode"],
}
